{
  "name": "totr-spa-linux",
  "private": true,
  "version": "0.6.3",
  "description": "TOTR listener app: the Linux shell (a window onto the server's own copy of the app). Its electron/ folder is a synced copy of ../shared/electron.",
  "author": "the TOTR authors",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "sync-ca": "node ../shared/tools/sync-ca.cjs",
    "stage-native": "node ../shared/tools/stage-native.cjs",
    "dist": "npm run sync-ca && npm run stage-native && electron-builder --linux AppImage --publish never",
    "release": "npm run dist && node ../shared/tools/deploy.cjs linux",
    "test": "node ../shared/tools/check-lock.cjs electron.lock.json electron && node ../shared/tools/check-lock.cjs build.lock.json build"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "multicast-dns": "7.2.5"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "org.totr.app",
    "productName": "TOTR",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "!electron/native/**",
      "package.json"
    ],
    "linux": {
      "extraResources": [
        {
          "from": "electron/native/linux",
          "to": "native",
          "filter": [
            "**/*",
            "!version.txt"
          ]
        }
      ],
      "target": [
        "AppImage"
      ],
      "category": "Audio",
      "executableName": "totr",
      "artifactName": "TOTR-${version}-linux.${ext}",
      "synopsis": "TOTR listener app"
    },
    "publish": {
      "provider": "generic",
      "url": "https://totr.example/static/downloads/",
      "channel": "latest"
    }
  },
  "desktopName": "totr.desktop"
}
